             "src/record_objects.c", "src/record_delete.c", "src/record_tasks.c", "src/record_archive.c", "src/record_import.c", "src/workshop.c", "src/job.c", "src/store_key_file.c", "src/store_preflight.c", "src/setup_status.c", "src/ui_store.c", "src/server.c"],
    fap_private_libs=private_libs,
